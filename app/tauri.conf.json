{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Three Finger Drag Linux",
  "version": "0.1.0",
  "identifier": "io.github.xuzenghui942.threefingerdrag",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "三指拖动（Linux）",
        "width": 980,
        "height": 760,
        "minWidth": 780,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ],
    "category": "Utility",
    "shortDescription": "GNOME Wayland 的三指拖动",
    "longDescription": "通过 Linux evdev 和 uinput 实现的本地三指拖动，专为 Ubuntu GNOME Wayland 会话设计。"
  }
}
