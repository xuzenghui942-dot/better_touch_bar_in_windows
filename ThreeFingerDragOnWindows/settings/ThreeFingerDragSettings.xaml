<Page
    x:Class="ThreeFingerDragOnWindows.settings.ThreeFingerDragSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:WinUICommunity"
    xmlns:local="using:ThreeFingerDragOnWindows.touchpad"
    mc:Ignorable="d">


    <ScrollView Margin="0"
                HorizontalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,0,20,20"
                    ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
                    Spacing="5">

            <InfoBar
                Title="设置窗口内的三指拖动可能不够流畅，请在其他窗口中测试实际效果。"
                IsIconVisible="False"
                IsOpen="True"
                IsClosable="True"
                Severity="Warning" />

            <wuc:SettingsCard
                Description="在触摸板上用三根手指选择文字、拖动窗口和其他对象（模拟按住鼠标键）。"
                HeaderIcon="{wuc:BitmapIcon Source='ms-appx:///Assets/icon-threefinger.png', ShowAsMonochrome=True}"
                Header="启用三指拖动">
                <ToggleSwitch x:Name="Enabled"
                              IsOn="{x:Bind EnabledProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wuc:SettingsCard>

            <wuc:SettingsExpander
                IsEnabled="{Binding ElementName=Enabled, Path=IsOn}"
                Description="请前往 Windows 设置（蓝牙和设备 > 触摸板），关闭系统自带的三指手势；也建议关闭“点击两次后拖动以多选”。"
                Header="关闭 Windows 自带的三指手势"
                IsExpanded="False"
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xEA37;}">
                <HyperlinkButton Content="打开系统设置"
                                 Click="OpenSettings" />
                <wuc:SettingsExpander.ItemsHeader>
                    <InfoBar
                        BorderThickness="0"
                        CornerRadius="0"
                        IsIconVisible="False"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Margin="-17,0,0,0">
                        <Grid Margin="5"
                              ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Source="ms-appx:///Assets/TouchpadThreeFingerSettings.png"
                                   Grid.Column="0"
                                   VerticalAlignment="Top" />
                            <Image Source="ms-appx:///Assets/TouchpadTapsSettings.png"
                                   Grid.Column="1"
                                   VerticalAlignment="Top" />
                        </Grid>
                    </InfoBar>
                </wuc:SettingsExpander.ItemsHeader>

            </wuc:SettingsExpander>

            <wuc:SettingsCard
                Description="通常选择左键，才能选择文字并拖动大多数对象。"
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE962;}"
                Header="拖动时按住的鼠标键">
                <ComboBox x:Name="ButtonType"
                          SelectedIndex="{x:Bind ButtonTypeProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          MinWidth="240">
                    <x:String>不按住</x:String>
                    <x:String>左键</x:String>
                    <x:String>右键</x:String>
                    <x:String>中键</x:String>
                </ComboBox>
            </wuc:SettingsCard>

            <wuc:SettingsExpander
                IsEnabled="{Binding ElementName=Enabled, Path=IsOn}"
                Description="三指离开后，若只放回一根或两根手指，会立即松开鼠标键；若暂不触碰，则会在短暂延迟后松开。这样可以在不结束拖动的情况下调整手指位置。"
                Header="允许短暂离开触摸板后继续拖动"
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE8B0;}"
                IsExpanded="True">
                <ToggleSwitch x:Name="AllowReleaseAndRestart"
                              IsOn="{x:Bind AllowReleaseAndRestartProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <wuc:SettingsExpander.Items>
                    <wuc:SettingsCard Description="建议值：500 毫秒。"
                                      Header="松开鼠标键前的延迟（毫秒）"
                                      IsEnabled="{Binding ElementName=AllowReleaseAndRestart, Path=IsOn}">
                        <NumberBox MinWidth="240"
                                   LargeChange="50"
                                   Maximum="2000"
                                   Minimum="0"
                                   SmallChange="100"
                                   SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ReleaseDelayProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wuc:SettingsCard>
                </wuc:SettingsExpander.Items>

            </wuc:SettingsExpander>

            <ItemsControl ItemsSource="{x:Bind MouseSpeedSettingItems}" Style="{x:Null}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:MouseSpeedSettings">
                        <wuc:SettingsExpander
                            IsEnabled="{Binding ElementName=Enabled, Path=IsOn}"
                            Description="Windows 默认不会让三指移动影响鼠标指针，因此本应用会自行移动指针，手感可能与单指操作略有不同。你可以在这里调整；如果已有其他三指移动方案，也可以关闭此功能。"
                            Header="{x:Bind Header}"
                            HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE7C2;}"
                            IsExpanded="True">
                            <ToggleSwitch x:Name="CursorMove"
                                          IsOn="{x:Bind CursorMoveProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <wuc:SettingsExpander.Items>
                                <!-- 滑块与数值框保持同步 -->
                                <wuc:SettingsCard Header="指针速度"
                                                  Description="默认值：30"
                                                  IsEnabled="{Binding ElementName=CursorMove, Path=IsOn}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                                        <!-- Slider -->
                                        <Slider MinWidth="200"
                                                StepFrequency="1"
                                                Maximum="200"
                                                Minimum="1"
                                                Value="{x:Bind CursorSpeedProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- NumberBox -->
                                        <NumberBox MinWidth="80"
                                                   Value="{x:Bind CursorSpeedProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Maximum="100000"
                                                   Minimum="0"
                                                   SmallChange="5"
                                                   LargeChange="10"
                                                   SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </wuc:SettingsCard>
                                       
                                <wuc:SettingsCard Description="默认值：10；设为 0 可关闭。"
                                                  Header="指针加速度"
                                                  IsEnabled="{Binding ElementName=CursorMove, Path=IsOn}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                                        <Slider MinWidth="200"
                                                StepFrequency="1"
                                                Maximum="30"
                                                Minimum="0"
                                                Value="{x:Bind CursorAccelerationProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <NumberBox MinWidth="80"
                                                   Value="{x:Bind CursorAccelerationProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0"
                                                   Maximum="1000"
                                                   SmallChange="5"
                                                   LargeChange="10"
                                                   SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </wuc:SettingsCard>
                            </wuc:SettingsExpander.Items>

                        </wuc:SettingsExpander>
                        
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <wuc:SettingsCard
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE768;}"
                Header="开始拖动阈值"
                Description="三指移动达到此距离后才开始拖动，用于区分三指与四指手势。建议值：100 像素。">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                    <Slider MinWidth="150"
                            StepFrequency="1"
                            Maximum="200"
                            Minimum="0"
                            Value="{x:Bind StartDragThresholdProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <NumberBox MinWidth="80"
                               Value="{x:Bind StartDragThresholdProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Minimum="0"
                               Maximum="1000"
                               SmallChange="5"
                               LargeChange="20"
                               SpinButtonPlacementMode="Compact" />
                </StackPanel>

            </wuc:SettingsCard>
            <wuc:SettingsCard
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE71A;}"
                Header="结束拖动阈值"
                Description="改用单指后，指针移动达到此距离便结束拖动。建议值：10 像素；此值不能高于开始拖动阈值。">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                    <Slider MinWidth="150"
                            StepFrequency="1"
                            Maximum="200"
                            Minimum="0"
                            Value="{x:Bind StopDragThresholdProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <NumberBox MinWidth="80"
                               Value="{x:Bind StopDragThresholdProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Minimum="0"
                               Maximum="1000"
                               SmallChange="1"
                               LargeChange="5"
                               SpinButtonPlacementMode="Compact" />
                </StackPanel>
            </wuc:SettingsCard>

            <Expander
                IsExpanded="False"
                ExpandDirection="Down"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Header="故障排查">

                <StackPanel Margin="0,0,0,0"
                            ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
                            Spacing="5">

                    <wuc:SettingsCard
                        Description="单次上报的手指移动超过此距离时会丢弃该记录，可减少触摸板数据跳变造成的指针跳动。设为 0 可关闭限制；默认值：0。"
                        Header="限制单次手指移动距离">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                            <Slider MinWidth="150"
                                    StepFrequency="1"
                                    Maximum="200"
                                    Minimum="0"
                                    Value="{x:Bind MaxFingerMoveDistanceProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <NumberBox MinWidth="80"
                                       Value="{x:Bind MaxFingerMoveDistanceProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Minimum="0"
                                       Maximum="10000"
                                       SmallChange="5"
                                       LargeChange="10"
                                       SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </wuc:SettingsCard>

                    <wuc:SettingsCard
                        Description="根据最近 N 次输入的平均值移动指针。提高数值可让移动更平滑，但会增加延迟；仅在指针抖动时调整。默认值：1。"
                        Header="指针移动平均次数">
                        <NumberBox MinWidth="60"
                                   Value="{x:Bind CursorAveragingProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="1"
                                   Maximum="10"
                                   SmallChange="1"
                                   LargeChange="1"
                                   SpinButtonPlacementMode="Compact" />
                    </wuc:SettingsCard>

                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollView>

</Page>
